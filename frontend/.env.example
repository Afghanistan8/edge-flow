# Deployed Edge-Flow contract on GenLayer Bradbury testnet (chain 4221).
VITE_EDGEFLOW_CONTRACT_ADDRESS=0x91Bb7FDD22dE81109Eca288F3CC5921352cD637f

# Optional RPC override. Defaults to the Bradbury public endpoint.
VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Optional WalletConnect Cloud project id (https://cloud.reown.com).
# Without it, injected wallets (MetaMask, Rabby, Brave) still connect;
# only the WalletConnect QR flow is degraded.
VITE_WALLETCONNECT_PROJECT_ID=
