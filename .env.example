# Edge-Flow environment.
#
# The frontend is built from `frontend/`, so copy this to `frontend/.env`
# for local dev. On Vercel, set the same VITE_* vars in Project Settings
# -> Environment Variables, then Redeploy — Vite inlines them at build
# time, so changing them without a rebuild has no effect.

# Deployed contract address on GenLayer Bradbury testnet (chain 4221).
VITE_EDGEFLOW_CONTRACT_ADDRESS=0x3E726A419600Fd7b59de44fA12c3Daf154Df7953

# Optional RPC override — defaults to the Bradbury public endpoint.
VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Optional WalletConnect Cloud project id (https://cloud.reown.com).
# Injected wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
