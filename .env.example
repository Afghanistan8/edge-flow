# Edge-Flow environment.
# Copy to `.env` (repo root) and to `frontend/.env` for the Vite build.

# Deployed contract address on GenLayer Bradbury testnet.
VITE_EDGEFLOW_CONTRACT_ADDRESS=0x071507a4d774A4caAeCCd081CD2bC138b4F7CeE7

# Optional RPC override — defaults to the Bradbury public endpoint.
VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
